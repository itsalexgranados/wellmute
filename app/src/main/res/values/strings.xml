    <!-- First-launch setup -->
    <string name="setup_welcome">Welcome to Wellmute</string>
    <string name="setup_intro_time_title">Know where your time goes</string>
    <string name="setup_intro_time_text">Screen time, unlocks and notifications for each app, by day, week, month and year.</string>
    <string name="setup_intro_rest_title">Use your phone on your terms</string>
    <string name="setup_intro_rest_text">App timers and Focus pause the apps that distract you. At night, Bedtime turns the screen gray and silences the rest.</string>
    <string name="setup_intro_private_title">Private by design</string>
    <string name="setup_intro_private_text">No internet access, no accounts, no ads. Everything stays on your phone, and the code is open source.</string>
    <plurals name="setup_intro_private_next">
        <item quantity="one">Next, Wellmute asks for %d permission and explains what it\'s for. You can skip it and allow it later in Settings. Notice that without all permissions, the app won\'t work properly.</item>
        <item quantity="other">Next, Wellmute asks for %d permissions and explains what each is for. You can skip any of them and allow them later in Settings. Notice that without all permissions, the app won\'t work properly.</item>
